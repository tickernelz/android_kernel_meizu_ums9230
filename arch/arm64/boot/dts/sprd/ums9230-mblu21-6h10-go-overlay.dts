	fragment@29 {
		target = <&bat>;

		__overlay__ {
			charge-full-design-microamp-hours = <0x4a0150>;
			constant-charge-voltage-max-microvolt = <0x441d80>;
			ocv-capacity-table-0 = <0x434e78 0x64 0x42f0b8 0x5f 0x422d68 0x5a 0x414ec0 0x55 0x406460 0x50 0x3f7de8 0x4b 0x3e9f40 0x46 0x3dd420 0x41 0x3d14b8 0x3c 0x3c1ea0 0x37 0x3b6708 0x32 0x3aedf0 0x2d 0x3a8860 0x28 0x3a3658 0x23 0x39f008 0x1e 0x399e00 0x19 0x393c58 0x14 0x38dab0 0xf 0x386198 0xa 0x3836a0 0x5 0x33e140 0x0>;
			charge-dcp-current-microamp = <0x249f00 0x231860>;
			charge-cdp-current-microamp = <0x249f00 0x231860>;
			charge-unknown-current-microamp = <0x83d60 0x83d60>;
			charge-sdp-current-microamp = <0x83d60 0x83d60>;
			charge-term-current-microamp = <0x186a0>;
			factory-internal-resistance-micro-ohms = <0x38270>;
			fullbatt-voltage = <0x434a90>;
			fullbatt-current = <0x1fbd0>;
			fullbatt-track-end-vol = <0x432380>;
			fullbatt-track-end-cur = <0x222e0>;
			first-calib-voltage = <0x367180>;
			first-calib-capacity = <0x1e>;
			voltage-min-design-microvolt = <0x34a490>;
			dcp-jeita-temp-table = <0x406 0x424 0x0 0x441d80 0x47e 0x46a 0xf4240 0x441d80 0x596 0x578 0x249f00 0x441d80 0x60e 0x5f0 0xf4240 0x441d80>;
			sdp-jeita-temp-table = <0x406 0x424 0x0 0x441d80 0x47e 0x46a 0x83d60 0x441d80 0x596 0x578 0x83d60 0x441d80 0x60e 0x5f0 0x83d60 0x441d80>;
			cdp-jeita-temp-table = <0x406 0x424 0x0 0x441d80 0x47e 0x46a 0xf4240 0x441d80 0x596 0x578 0x249f00 0x441d80 0x60e 0x5f0 0xf4240 0x441d80>;
			unknown-jeita-temp-table = <0x406 0x424 0x0 0x441d80 0x47e 0x46a 0x83d60 0x441d80 0x596 0x578 0x83d60 0x441d80 0x60e 0x5f0 0x83d60 0x441d80>;
		};
	};

	fragment@30 {
		target = <&pmic_fgu>;

		__overlay__ {
			sprd,calib-resistance-micro-ohms = <0x133b>;
			sprd,comp-resistance-mohm = <0x14>;
			fgu-cap-remap-table = <0x0 0x1 0x2 0x1 0x2 0x1 0x62 0x63 0x2 0x63 0x64 0x3>;
		};
	};

	fragment@31 {
		target = <&i2c0>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			sensor_main: sensor-main@20 {
				compatible = "sprd,sensor-main";
				reg = <0x20>;
				clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_76m8", "clk_48m", "clk_26m";
				clocks = <&mm_clk 0x2 &mm_gate 0xd &pll1 0x4 &pll1 0x10 &pll1 0x5 &ext_26m>;
				vddio-supply = <&vddcamio>;
				vddcama-supply = <&vddcama0>;
				vddcamd-supply = <&vddcamd0>;
				vddcammot-supply = <&vddcammot>;
				sprd,phyid = <0x0>;
				csi = <&csi0>;
				reset-gpios = <&ap_gpio 0x2d 0x0>;
				power-down-gpios = <&ap_gpio 0x2f 0x0>;
				power-domains = <&mm_domain>;
			};

			sensor_sub: sensor-sub@5a {
				compatible = "sprd,sensor-sub";
				reg = <0x5a>;
				clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_76m8", "clk_48m", "clk_26m";
				clocks = <&mm_clk 0x2 &mm_gate 0xd &pll1 0x4 &pll1 0x10 &pll1 0x5 &ext_26m>;
				vddio-supply = <&vddcamio>;
				vddcama-supply = <&vddcama0>;
				vddcamd-supply = <&vddcamd0>;
				vddcammot-supply = <&vddcammot>;
				sprd,phyid = <0x2>;
				csi = <&csi0>;
				reset-gpios = <&ap_gpio 0x2c 0x0>;
				power-down-gpios = <&ap_gpio 0x2e 0x0>;
				power-domains = <&mm_domain>;
			};
		};
	};

	fragment@32 {
		target = <&i2c1>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			sensor_sub2: sensor-sub2@6c {
				compatible = "sprd,sensor-sub2";
				reg = <0x6c>;
				clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_76m8", "clk_48m", "clk_26m";
				clocks = <&mm_clk 0x3 &mm_gate 0xc &pll1 0x4 &pll1 0x10 &pll1 0x5 &ext_26m>;
				vddio-supply = <&vddcamio>;
				vddcama-supply = <&vddcama1>;
				vddcamd-supply = <&vddcamd0>;
				sprd,phyid = <0x3>;
				csi = <&csi1>;
				reset-gpios = <&ap_gpio 0x29 0x0>;
				power-down-gpios = <&ap_gpio 0x28 0x0>;
				power-domains = <&mm_domain>;
			};
		};
	};

	fragment@33 {
		target = <&i2c6>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			sensor_main2: sensor-main2@20 {
				compatible = "sprd,sensor-main2";
				reg = <0x20>;
				clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_76m8", "clk_48m", "clk_26m";
				clocks = <&mm_clk 0x4 &mm_gate 0xb &pll1 0x4 &pll1 0x10 &pll1 0x5 &ext_26m>;
				vddio-supply = <&vddcamio>;
				vddcama-supply = <&vddcama1>;
				vddcamd-supply = <&vddcamd1>;
				vddcammot-supply = <&vddcammot>;
				reset-gpios = <&ap_gpio 0x29 0x0>;
				power-down-gpios = <&ap_gpio 0x28 0x0>;
				sprd,phyid = <0x4>;
				csi = <&csi2>;
				power-domains = <&mm_domain>;
			};
		};
	};

	fragment@34 {
		target = <&sound_vbc_v4_sprd_codec>;

		__overlay__ {
			status = "okay";
			sprd,spk-ext-pa-info = <0x0 0x1 0x3 0x0 0x1 0x1 0x3 0x0 0x2 0x1 0x3 0x2>;
			sprd,spk-ext-pa-gpio = <&ap_gpio 0x89 0x0 &ap_gpio 0x70 0x0 &ap_gpio 0x70 0x0>;
		};
	};

	fragment@35 {
		target = <&sdio0>;

		__overlay__ {
			cd-gpios = <&eic_async 0x23 0x0>;
		};
	};

	fragment@36 {
		target = <&vddkpled>;

		__overlay__ {
			regulator-always-on;
		};
	};

	fragment@37 {
		target = <&spi2>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			spi_tp@0 {
				compatible = "tchip,ilitek", "focaltech,fts";
				reg = <0x0>;
				spi-max-frequency = <0x989680>;
				touch,reset-gpio = <&ap_gpio 0x91 0x0>;
				touch,irq-gpio = <&ap_gpio 0x90 0x0>;
				focaltech,irq-gpio = <&ap_gpio 0x90 0x0>;
				focaltech,reset-gpio = <&ap_gpio 0x91 0x0>;
				focaltech,display-coords = <0x0 0x0 0x2d0 0x668>;
				focaltech,max-touch-number = <0xa>;
			};
		};
	};
};
