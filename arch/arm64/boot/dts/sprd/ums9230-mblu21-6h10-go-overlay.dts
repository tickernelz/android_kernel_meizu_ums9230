/dts-v1/;
/plugin/;

/ {
	model = "Spreadtrum UMS9230 6H10 Board";
	compatible = "sprd,ums9230-6h10-go";
	sprd,sc-id = "ums9230 6h10 go";
	sprd,board_id = <0x690000>;

	fragment {
		target-path = "/";

		__overlay__ {
			#address-cells = <0x2>;
			#size-cells = <0x2>;

			lcds {
				lcd_ili9883c_mipi: lcd_ili9883c_mipi {
					sprd,dsi-work-mode = <0x1>;
					sprd,dsi-lane-number = <0x4>;
					sprd,dsi-color-format = "rgb888";
					sprd,phy-bit-clock = <0x10dc68>;
					sprd,vrr-enabled;
					sprd,width-mm = <0x45>;
					sprd,height-mm = <0x9e>;
					sprd,esd-check-enable = <0x0>;
					sprd,esd-check-mode = <0x1>;
					sprd,esd-check-period = <0x7d0>;
					sprd,esd-check-register = <0xa>;
					sprd,esd-check-value = <0x9d>;
					sprd,reset-on-sequence = <0x1 0xa 0x0 0x14 0x1 0x78>;
					sprd,reset-off-sequence = <0x0 0x14>;
					sprd,initial-command = [29 00 00 04 ff 98 83 01 29 00 00 02 00 4a 29 00 00 02 01 35 29 00 00 02 04 d0 29 00 00 02 05 33 29 00 00 02 08 84 29 00 00 02 09 03 29 00 00 02 0a 71 29 00 00 02 ed a4 29 00 00 02 2c 3d 29 00 00 02 d0 01 29 00 00 02 d1 f2 29 00 00 02 d3 01 29 00 00 02 d5 51 29 00 00 02 d6 20 29 00 00 02 d7 10 29 00 00 02 d8 00 29 00 00 02 da 20 29 00 00 02 dc c2 29 00 00 02 dd 22 29 00 00 02 df b6 29 00 00 02 e0 5e 29 00 00 02 e2 42 29 00 00 02 e7 10 29 00 00 02 e6 32 29 00 00 02 ee 15 29 00 00 02 f1 00 29 00 00 02 f2 00 29 00 00 02 f6 1f 29 00 00 02 31 07 29 00 00 02 32 28 29 00 00 02 33 29 29 00 00 02 34 0c 29 00 00 02 35 07 29 00 00 02 36 21 29 00 00 02 37 21 29 00 00 02 38 16 29 00 00 02 39 14 29 00 00 02 3a 12 29 00 00 02 3b 10 29 00 00 02 3c 08 29 00 00 02 3d 07 29 00 00 02 3e 07 29 00 00 02 3f 07 29 00 00 02 40 07 29 00 00 02 41 07 29 00 00 02 42 07 29 00 00 02 43 07 29 00 00 02 44 07 29 00 00 02 45 07 29 00 00 02 46 07 29 00 00 02 47 02 29 00 00 02 48 28 29 00 00 02 49 29 29 00 00 02 4a 0d 29 00 00 02 4b 07 29 00 00 02 4c 21 29 00 00 02 4d 21 29 00 00 02 4e 17 29 00 00 02 4f 15 29 00 00 02 50 13 29 00 00 02 51 11 29 00 00 02 52 09 29 00 00 02 53 07 29 00 00 02 54 07 29 00 00 02 55 07 29 00 00 02 56 07 29 00 00 02 57 07 29 00 00 02 58 07 29 00 00 02 59 07 29 00 00 02 5a 07 29 00 00 02 5b 07 29 00 00 02 5c 07 29 00 00 04 ff 98 83 02 29 00 00 02 06 55 29 00 00 02 0a 5b 29 00 00 02 0c 00 29 00 00 02 0d 20 29 00 00 02 0e 74 29 00 00 02 39 05 29 00 00 02 3a 20 29 00 00 02 3b 74 29 00 00 02 3c a6 29 00 00 02 f0 01 29 00 00 02 f1 74 29 00 00 02 29 48 29 00 00 02 2a 48 29 00 00 04 ff 98 83 05 29 00 00 02 00 01 29 00 00 02 03 00 29 00 00 02 04 4c 29 00 00 02 69 83 29 00 00 02 6a 83 29 00 00 02 6d 65 29 00 00 02 73 6b 29 00 00 02 79 a1 29 00 00 02 7f 93 29 00 00 02 68 3e 29 00 00 02 66 33 29 00 00 02 4e 32 29 00 00 02 53 ff 29 00 00 02 1f 50 29 00 00 02 20 01 29 00 00 02 a4 ff 29 00 00 02 2d 54 29 00 00 02 2e 64 29 00 00 02 c0 54 29 00 00 02 c2 64 29 00 00 02 c8 61 29 00 00 04 ff 98 83 06 29 00 00 02 d9 1f 29 00 00 02 c0 68 29 00 00 02 c1 16 29 00 00 02 93 50 29 00 00 02 0a 50 29 00 00 04 ff 98 83 08 29 00 00 1e e0 00 00 29 74 b2 54 f7 2d 56 86 a5 ac e7 17 42 aa 6c 97 ca e9 ff 12 33 5c 91 3f b8 d5 d7 29 00 00 1e e1 00 00 29 74 b2 54 f7 2d 56 86 a5 ac e7 17 42 aa 6c 97 ca e9 ff 12 33 5c 91 3f b8 d5 d7 29 00 00 04 ff 98 83 0b 29 00 00 02 9a 85 29 00 00 02 9b 6f 29 00 00 02 9c 04 29 00 00 02 9d 04 29 00 00 02 9e 88 29 00 00 02 9f 88 29 00 00 02 aa 22 29 00 00 02 ab e0 29 00 00 04 ff 98 83 0e 29 00 00 02 11 4b 29 00 00 02 12 02 29 00 00 02 13 14 29 00 00 02 00 a0 29 00 00 04 ff 98 83 00 29 00 00 02 35 00 13 78 00 01 11 13 32 00 01 29];
					sprd,sleep-in-command = [13 32 00 01 28 13 78 00 01 10];
					sprd,sleep-out-command = [13 78 00 01 11 13 32 00 01 29];

					display-timings {
						native-mode = <&ili9883c_timing0>;

						ili9883c_timing0: timing0 {
							clock-frequency = <0x927c000>;
							hactive = <0x2d0>;
							vactive = <0x668>;
							hfront-porch = <0x54>;
							hback-porch = <0x14>;
							hsync-len = <0xa>;
							vfront-porch = <0x578>;
							vback-porch = <0x1e>;
							vsync-len = <0x2>;
						};

						ili9883c_timing1: timing1 {
							clock-frequency = <0x927c000>;
							hactive = <0x2d0>;
							vactive = <0x668>;
							hfront-porch = <0x54>;
							hback-porch = <0x14>;
							hsync-len = <0xa>;
							vfront-porch = <0x174>;
							vback-porch = <0x1e>;
							vsync-len = <0x2>;
						};
					};
				};

				lcd_ft8057_mipi: lcd_ft8057_mipi {
					sprd,dsi-work-mode = <0x1>;
					sprd,dsi-lane-number = <0x4>;
					sprd,dsi-color-format = "rgb888";
					sprd,phy-bit-clock = <0x1126a0>;
					sprd,vrr-enabled;
					sprd,width-mm = <0x45>;
					sprd,height-mm = <0x9e>;
					sprd,esd-check-enable = <0x0>;
					sprd,esd-check-mode = <0x1>;
					sprd,esd-check-period = <0x7d0>;
					sprd,esd-check-register = <0xa>;
					sprd,esd-check-value = <0x9d>;
					sprd,reset-on-sequence = <0x1 0xa 0x0 0x14 0x1 0x78>;
					sprd,reset-off-sequence = <0x0 0x14>;
					sprd,initial-command = [23 00 00 02 00 00 29 00 00 04 ff 80 57 01 23 00 00 02 00 80 29 00 00 03 ff 80 57 23 00 00 02 00 a3 29 00 00 05 b3 06 68 00 18 23 00 00 02 00 93 23 00 00 02 c5 4d 23 00 00 02 00 97 23 00 00 02 c5 4d 23 00 00 02 00 9a 23 00 00 02 c5 d5 23 00 00 02 00 9c 23 00 00 02 c5 d5 23 00 00 02 00 b6 29 00 00 03 c5 2f 2f 23 00 00 02 00 b8 29 00 00 03 c5 41 41 23 00 00 02 00 00 29 00 00 03 d8 2d 2d 23 00 00 02 00 00 29 00 00 03 d9 00 d5 23 00 00 02 00 07 29 00 00 04 d9 00 49 49 23 00 00 02 00 82 23 00 00 02 c5 55 23 00 00 02 00 83 23 00 00 02 c5 07 23 00 00 02 00 96 23 00 00 02 f5 0d 23 00 00 02 00 86 23 00 00 02 f5 0d 23 00 00 02 00 94 23 00 00 02 c5 15 23 00 00 02 00 9b 23 00 00 02 c5 51 23 00 00 02 00 a3 23 00 00 02 a5 04 23 00 00 02 00 99 23 00 00 02 cf 56 23 00 00 02 00 86 23 00 00 02 b7 80 23 00 00 02 00 a5 23 00 00 02 b0 1d 23 00 00 02 00 00 29 00 00 11 e1 0c 11 1d 2a 32 3b 4d 59 5b 69 6c 83 7e 6a 68 5d 23 00 00 02 00 10 29 00 00 09 e1 55 49 3a 31 28 1b 13 12 23 00 00 02 00 00 29 00 00 11 e2 0c 11 1d 2a 32 3b 4d 59 5b 69 6c 83 7e 6a 68 5d 23 00 00 02 00 10 29 00 00 09 e2 55 49 3a 31 28 1b 13 12 23 00 00 02 00 80 29 00 00 07 c0 00 d2 00 2e 00 1c 23 00 00 02 00 90 29 00 00 07 c0 00 83 00 2e 00 1c 23 00 00 02 00 a0 29 00 00 07 c0 00 d2 00 2e 00 1c 23 00 00 02 00 b0 29 00 00 06 c0 00 e6 00 2e 1c 23 00 00 02 00 c1 29 00 00 09 c0 01 33 00 e1 00 cd 01 52 23 00 00 02 00 70 29 00 00 07 c0 00 83 00 2e 00 1c 23 00 00 02 00 a3 29 00 00 07 c1 00 33 00 3c 00 02 23 00 00 02 00 b7 29 00 00 03 c1 00 33 23 00 00 02 00 73 29 00 00 03 ce 09 09 23 00 00 02 00 80 29 00 00 11 ce 01 81 09 09 00 78 00 96 00 78 00 96 00 78 00 96 23 00 00 02 00 90 29 00 00 10 ce 00 8c 13 24 00 8c 80 09 09 00 07 d0 16 16 17 23 00 00 02 00 a0 29 00 00 04 ce 20 00 00 23 00 00 02 00 b0 29 00 00 04 ce 87 00 00 23 00 00 02 00 d1 29 00 00 08 ce 00 00 01 00 00 00 00 23 00 00 02 00 e1 29 00 00 0c ce 08 03 31 03 31 02 48 00 00 00 00 23 00 00 02 00 f1 29 00 00 0a ce 14 14 1e 01 1f 01 1f 01 1f 23 00 00 02 00 b0 29 00 00 05 cf 00 00 6f 73 23 00 00 02 00 b5 29 00 00 05 cf 03 03 5d 61 23 00 00 02 00 c0 29 00 00 05 cf 06 06 47 4b 23 00 00 02 00 c5 29 00 00 05 cf 06 06 4b 4f 23 00 00 02 00 60 29 00 00 09 cf 00 00 6f 73 03 03 5d 61 23 00 00 02 00 70 29 00 00 09 cf 00 00 69 6d 03 03 57 5b 23 00 00 02 00 aa 29 00 00 05 cf 80 80 1c 18 23 00 00 02 00 d1 29 00 00 0d c1 03 aa 05 22 09 59 05 87 08 23 0f ac 23 00 00 02 00 e1 29 00 00 03 c1 05 22 23 00 00 02 00 e2 29 00 00 0d cf 06 de 06 dd 06 dd 06 dd 06 dd 06 dd 23 00 00 02 00 80 29 00 00 03 c1 22 22 23 00 00 02 00 90 23 00 00 02 c1 02 23 00 00 02 00 f5 23 00 00 02 cf 01 23 00 00 02 00 f6 23 00 00 02 cf 5a 23 00 00 02 00 f1 23 00 00 02 cf 5a 23 00 00 02 00 f7 23 00 00 02 cf 11 23 00 00 02 00 80 29 00 00 11 cc 1e 1c 1d 21 00 26 26 0d 0b 09 07 03 00 00 00 00 23 00 00 02 00 90 29 00 00 09 cc 00 00 00 00 00 00 00 00 23 00 00 02 00 80 29 00 00 11 cd 00 1c 1d 20 00 26 26 0c 0a 08 06 02 00 00 00 00 23 00 00 02 00 90 29 00 00 09 cd 00 00 00 00 00 00 00 00 23 00 00 02 00 80 29 00 00 11 cb c1 c1 c1 c1 c1 c1 c1 cd cd c1 cd cd 00 c1 c1 c1 23 00 00 02 00 ed 23 00 00 02 cb c1 23 00 00 02 00 90 29 00 00 11 cb 00 00 00 00 00 00 00 00 00 00 40 40 00 00 00 00 23 00 00 02 00 ee 23 00 00 02 cb 00 23 00 00 02 00 90 23 00 00 02 c3 00 23 00 00 02 00 a0 29 00 00 09 cb 00 00 00 00 00 00 00 00 23 00 00 02 00 b0 29 00 00 05 cb 55 55 55 15 23 00 00 02 00 c0 29 00 00 05 cb 55 55 55 15 23 00 00 02 00 d2 29 00 00 0c cb 83 00 c3 83 00 83 c3 00 c3 83 00 23 00 00 02 00 e0 29 00 00 0e cb 83 83 00 83 83 00 83 03 00 83 83 00 c3 23 00 00 02 00 fa 29 00 00 03 cb 83 00 23 00 00 02 00 ef 23 00 00 02 cb 05 23 00 00 02 00 68 29 00 00 05 c2 8c 06 b1 ba 23 00 00 02 00 6c 29 00 00 05 c2 8b 06 b1 ba 23 00 00 02 00 e0 29 00 00 05 c3 00 00 00 00 23 00 00 02 00 e4 29 00 00 05 c3 00 00 00 00 23 00 00 02 00 fd 29 00 00 03 cb 22 b0 23 00 00 02 00 f5 29 00 00 04 cd 95 33 94 23 00 00 02 00 84 29 00 00 05 c2 04 04 bc bc 23 00 00 02 00 ea 29 00 00 07 c2 00 60 6b 08 bc bc 23 00 00 02 00 8c 29 00 00 06 c2 86 01 03 cf ba 23 00 00 02 00 91 29 00 00 06 c2 85 01 03 cf ba 23 00 00 02 00 96 29 00 00 06 c2 84 01 03 cf ba 23 00 00 02 00 9b 29 00 00 06 c2 83 02 03 cf ba 23 00 00 02 00 a0 29 00 00 06 c2 82 03 03 cf ba 23 00 00 02 00 a5 29 00 00 06 c2 81 04 03 cf ba 23 00 00 02 00 aa 29 00 00 06 c2 80 05 03 cf ba 23 00 00 02 00 af 29 00 00 06 c2 01 06 03 cf ba 23 00 00 02 00 dc 29 00 00 05 c2 77 77 77 77 23 00 00 02 00 fc 29 00 00 03 cb 06 22 23 00 00 02 00 ff 23 00 00 02 cb 78 23 00 00 02 00 fb 29 00 00 05 c3 97 00 97 00 23 00 00 02 00 98 23 00 00 02 c4 08 23 00 00 02 00 90 29 00 00 06 e9 10 ff ff ff 00 23 00 00 02 00 85 23 00 00 02 c4 80 23 00 00 02 00 81 23 00 00 02 a4 73 23 00 00 02 00 86 23 00 00 02 a4 b6 23 00 00 02 00 95 23 00 00 02 c4 80 23 00 00 02 00 ca 29 00 00 03 c0 80 00 23 00 00 02 00 cc 23 00 00 02 c0 00 23 00 00 02 00 b7 23 00 00 02 f5 1f 23 00 00 02 00 b1 23 00 00 02 f5 5f 23 00 00 02 00 cc 23 00 00 02 c0 10 23 00 00 02 00 b4 23 00 00 02 cb 10 23 00 00 02 00 85 23 00 00 02 a4 95 23 00 00 02 00 a0 29 00 00 03 a5 27 0e 23 00 00 02 00 03 23 00 00 02 d9 24 23 00 00 02 00 f9 23 00 00 02 cb 20 23 00 00 02 00 b8 29 00 00 05 cd 00 00 ff ff 23 00 00 02 00 bc 23 00 00 02 c5 06 23 00 00 02 00 b0 23 00 00 02 c5 00 23 00 00 02 00 b3 23 00 00 02 c5 00 23 00 00 02 00 b2 23 00 00 02 c5 0d 23 00 00 02 00 b5 23 00 00 02 c5 02 23 00 00 02 00 bc 23 00 00 02 c5 20 23 00 00 02 00 c2 23 00 00 02 f5 42 23 00 00 02 00 80 23 00 00 02 ce 00 23 00 00 02 00 d0 23 00 00 02 ce 01 23 00 00 02 00 e0 23 00 00 02 ce 00 23 00 00 02 00 a1 23 00 00 02 c1 cc 23 00 00 02 00 70 29 00 00 07 c0 00 83 00 2e 00 1c 23 00 00 02 00 d1 29 00 00 08 ce 00 0a 01 01 01 2b 01 23 00 00 02 00 e8 29 00 00 05 ce 01 2b 01 2b 23 00 00 02 00 00 29 00 00 04 ff 00 00 00 23 00 00 02 00 80 29 00 00 03 ff 00 00 29 00 00 02 35 00 13 78 00 01 11 13 32 00 01 29];
					sprd,sleep-in-command = [13 32 00 01 28 13 78 00 01 10];
					sprd,sleep-out-command = [13 78 00 01 11 13 32 00 01 29];

					display-timings {
						native-mode = <&ft8057_timing0>;

						ft8057_timing0: timing0 {
							clock-frequency = <0x7a12000>;
							hactive = <0x2d0>;
							vactive = <0x668>;
							hfront-porch = <0x28>;
							hback-porch = <0x28>;
							hsync-len = <0x4>;
							vfront-porch = <0x3d4>;
							vback-porch = <0x1c>;
							vsync-len = <0x2>;
						};

						ft8057_timing1: timing1 {
							clock-frequency = <0x7a12000>;
							hactive = <0x2d0>;
							vactive = <0x668>;
							hfront-porch = <0x10>;
							hback-porch = <0x10>;
