				reg = <0x0 0x87600000 0x0 0x180000>;
				sprd,file-name = "/dev/block/platform/soc/soc:ap-apb/201d0000.sdio/by-name/gnssmodem";
				sprd,file-name-ext = "/dev/block/platform/soc/soc:ap-apb/201d0000.sdio/by-name/gnssmodem";
				sprd,file-name-ufs = "/dev/block/platform/soc/soc:ap-apb/20200000.ufs/by-name/gnssmodem";
				sprd,file-name-ext-ufs = "/dev/block/platform/soc/soc:ap-apb/20200000.ufs/by-name/gnssmodem";
				sprd,file-length = <0x180000>;
				sprd,apcp-sync-addr = <0x1ffc00>;
				sprd,wcn-sipc-ver = <0x1>;
				vddwcn-supply = <&vddwcn>;
				dcxo1v8-supply = <&vddsim2>;
				merlion-chip-en-gpios = <&ap_gpio 0x76 0x0>;
				merlion-rst-gpios = <&ap_gpio 0x75 0x0>;
				xtal-26m-type-sel-gpios = <&ap_gpio 0xad 0x0>;
				#address-cells = <0x1>;
				#size-cells = <0x1>;
				nvmem-cells = <&wcn_alpha>;
				nvmem-cell-names = "gnss_efuse_blk0";

				wcn-dump {
					gnss-dump {
						sprd,aon-control = <0x40c00000 0x64 0x11000000 0x0>;
						sprd,aon-ahb-sys = <0x40b18000 0x42c 0x11000000 0x0>;
						sprd,aon-apb-peri = <0x40bc8000 0x2e4 0x11000000 0x0>;
						sprd,aon-wcn-gnss-clk = <0x40bd8000 0x54 0x11000000 0x0>;
						sprd,gnss-iram-pchannel = <0x40e40000 0x20000 0x11000000 0x0>;
						sprd,gnss-iram = <0x40a50000 0x8000 0x11000000 0x0>;
						sprd,gnss-sipc-buff = <0x88240000 0x40000 0x0 0x0>;
						sprd,gnss-share-mem = <0x0 0x200000 0x87600000 0x0>;
					};
				};
			};

			gnss_common_ctl {
				compatible = "sprd,gnss";
				sprd,name = "gnss_common_ctl";
			};

			pwm_backlight: sprd_backlight {
				compatible = "sprd,sharkl6-backlight";
				pwms = <&pwms 0x2 0x9c40>;
				pwm-names = "backlight";
				sprd,max-brightness-level = <0x39c>;
				default-brightness-level = <0x106>;
				sprd,brightness-scale = <0x3ff>;
				brightness-levels = <0x0 0x3 0x4 0x5 0x6 0x7 0x8 0x9 0xa 0xb 0xc 0xd 0xe 0xf 0x10 0x11 0x12 0x13 0x14 0x15 0x17 0x19 0x1b 0x1d 0x1f 0x21 0x23 0x25 0x27 0x29 0x2b 0x2d 0x2f 0x31 0x33 0x35 0x37 0x39 0x3b 0x3d 0x3f 0x41 0x43 0x45 0x47 0x49 0x4b 0x4d 0x4f 0x51 0x53 0x55 0x57 0x59 0x5b 0x5d 0x5f 0x61 0x63 0x65 0x67 0x69 0x6b 0x6d 0x6f 0x71 0x73 0x75 0x77 0x79 0x7b 0x7d 0x7f 0x81 0x83 0x85 0x87 0x89 0x8b 0x8d 0x8f 0x92 0x95 0x98 0x9b 0x9e 0xa1 0xa4 0xa7 0xaa 0xad 0xb0 0xb3 0xb6 0xb9 0xbc 0xbf 0xc2 0xc5 0xc8 0xcb 0xce 0xd1 0xd4 0xd7 0xda 0xdd 0xe0 0xe3 0xe6 0xe9 0xed 0xf1 0xf5 0xf8 0xfc 0x100 0x104 0x108 0x10c 0x110 0x114 0x118 0x11c 0x120 0x124 0x128 0x12c 0x130 0x134 0x138 0x13c 0x140 0x144 0x148 0x14c 0x150 0x156 0x15a 0x15e 0x163 0x168 0x16d 0x172 0x177 0x17c 0x181 0x186 0x18b 0x190 0x196 0x19c 0x1a2 0x1a8 0x1ae 0x1b4 0x1ba 0x1c0 0x1c6 0x1cc 0x1d2 0x1d8 0x1de 0x1e4 0x1ea 0x1f0 0x1f6 0x1fc 0x202 0x207 0x20c 0x212 0x218 0x21e 0x224 0x22a 0x230 0x236 0x23c 0x242 0x248 0x24e 0x254 0x25a 0x260 0x266 0x26c 0x272 0x278 0x27e 0x284 0x28a 0x290 0x296 0x29e 0x2a4 0x2aa 0x2b0 0x2b6 0x2bc 0x2c2 0x2c8 0x2ce 0x2d4 0x2da 0x2e0 0x2e6 0x2ec 0x2f2 0x2f8 0x2fe 0x304 0x30a 0x310 0x316 0x31c 0x322 0x328 0x32e 0x334 0x33a 0x340 0x346 0x34c 0x352 0x358 0x35e 0x364 0x36a 0x370 0x376 0x37c 0x382 0x388 0x38e 0x394 0x39a 0x3a0 0x3a6 0x3ac 0x3b1 0x3b6 0x3bb 0x3c0 0x3c5 0x3ca 0x3cf 0x3d4 0x3d9 0x3de 0x3e3 0x3e8 0x3ee 0x3f4 0x3fa 0x3ff>;
			};

			flash_gpio: flash-gpio {
				compatible = "sprd,flash-gpio";
				flash-torch-en-gpios = <&ap_gpio 0x20 0x0>;
				flash-en-gpios = <&ap_gpio 0x8b 0x0>;
				flash-torch-en-gpios-1 = <&ap_gpio 0x83 0x0>;
				flash-en-gpios-1 = <&ap_gpio 0x36 0x0>;
				flash-torch-en-gpios-2 = <&ap_gpio 0x83 0x0>;
				flash-en-gpios-2 = <&ap_gpio 0x72 0x0>;
			};

			gpio_keys: gpio-keys {
				compatible = "gpio-keys";

				key-volumedown {
					label = "Volume Down Key";
					linux,code = <0x72>;
					gpios = <&pmic_eic 0x4 0x0>;
					debounce-interval = <0x2>;
					wakeup-source;
				};

				key-volumeup {
					label = "Volume Up Key";
					linux,code = <0x73>;
					gpios = <&ap_gpio 0x7c 0x1>;
					debounce-interval = <0x2>;
					wakeup-source;
				};

				key-power {
					label = "Power Key";
					linux,code = <0x74>;
					gpios = <&pmic_eic 0x1 0x1>;
					debounce-interval = <0x2>;
					wakeup-source;
				};

				key-side {
					label = "Side Key";
					linux,code = <0x136>;
					gpios = <&ap_gpio 0x7d 0x1>;
					debounce-interval = <0x2>;
				};
			};

			audio-voice-trig {
				status = "disable";
				compatible = "sprd,voice_trig";
				irq_gpio = <&ap_gpio 0xa9 0x0>;
			};

			sprd-uid {
				compatible = "sprd,uid";
				nvmem-cells = <&uid_start &uid_end>;
				nvmem-cell-names = "uid_start", "uid_end";
			};

			blestech_fp: fingerprint_blestech {
				compatible = "sprd,betterlife-fp";
				reset-gpio = <&ap_gpio 0x8a 0x0>;
				int_gpio = <&eic_async 0x1c 0x0>;
			};

			cdfinger_fp: cdfinger_fingerprint {
				compatible = "cdfinger,fingerprint";
				fpreset-gpios = <&ap_gpio 0x8a 0x0>;
				fpint-gpios = <&eic_async 0x1c 0x0>;
			};

			sunwave_fp: sunwave-fp {
				compatible = "sunwave,fingerprint";
				sunwave,reset-gpio = <&ap_gpio 0x8a 0x0>;
				sunwave,irq-gpio = <&eic_async 0x1c 0x0>;
			};

			microarray_fp: ma-fingerprint {
				compatible = "microarray,fingerprint";
				maint-gpios = <&eic_async 0x1c 0x0>;
			};

			chipone_fp: fpsensor-fp {
				compatible = "fpsensor,fingerprint";
				fpreset-gpios = <&ap_gpio 0x8a 0x0>;
				fpint-gpios = <&eic_async 0x1c 0x0>;
			};

			silead_fp: silead-fp {
				compatible = "sil,silead_fp";
				rst-gpios = <&ap_gpio 0x8a 0x0>;
				irq-gpios = <&eic_async 0x1c 0x0>;
			};
		};
	};

	fragment@0 {
		target = <&panel>;

		__overlay__ {
			sprd,backlight = <&pwm_backlight>;
			avdd-gpio = <&ap_gpio 0x3c 0x0>;
			avee-gpio = <&ap_gpio 0x3d 0x0>;
			reset-gpio = <&ap_gpio 0x32 0x0>;
		};
	};

	fragment@1 {
		target = <&bat>;

		__overlay__ {
			compatible = "simple-battery";
			status = "okay";
			charge-full-design-microamp-hours = <0x2d0370>;
			charge-term-current-microamp = <0xea60>;
			constant-charge-voltage-max-microvolt = <0x423920>;
			factory-internal-resistance-micro-ohms = <0x3d860>;
			voltage-min-design-microvolt = <0x34a490>;
			fast-charge-threshold-microvolt = <0x3e8fa0>;
			fullbatt-voltage = <0x419ce0>;
			fullbatt-current = <0x1d4c0>;
			first-fullbatt-current = <0x249f0>;
			fullbatt-track-end-vol = <0x418958>;
			fullbatt-track-end-cur = <0x1fbd0>;
			first-calib-voltage = <0x36a060>;
			first-calib-capacity = <0x32>;
			ir-cv-offset-microvolt = <0x186a0>;
			ir-rc-micro-ohms = <0x4e20>;
			ir-us-upper-limit-microvolt = <0x44aa20>;
			ocv-capacity-celsius = <0x14>;
			ocv-capacity-table-0 = <0x41cfa8 0x64 0x40e930 0x5f 0x401a28 0x5a 0x3f56d8 0x55 0x3e9770 0x50 0x3df360 0x4b 0x3d2070 0x46 0x3c9f88 0x41 0x3bf790 0x3c 0x3b3c10 0x37 0x3ac2f8 0x32 0x3a6d08 0x2d 0x3a22d0 0x28 0x39e838 0x23 0x39b188 0x1e 0x397308 0x19 0x3928d0 0x14 0x38cb10 0xf 0x385db0 0xa 0x382ed0 0x5 0x33e140 0x0>;
			voltage-temp-table = <0x10f0fe 0x320 0xf4010 0x352 0xd963e 0x384 0xbfcb6 0x3b6 0xa7e0e 0x3e8 0x920cc 0x41a 0x7e630 0x44c 0x6ce94 0x47e 0x5d99e 0x4b0 0x504f6 0x4e2 0x44cf0 0x514 0x3af48 0x546 0x328b6 0x578 0x2b5ac 0x5aa 0x253aa 0x5dc 0x20058 0x60e 0x1b968 0x640 0x17dfe 0x672>;
			capacity-temp-table = <0x2d 0x64 0x19 0x64 0xa 0x64 0x0 0x5f 0xfffffff6 0x5a>;
			resistance-temp-table = <0x2d 0x35 0x19 0x64 0xa 0x18b 0x0 0x237 0xfffffff6 0x319>;
			charge-sdp-current-microamp = <0x7a120 0x7a120>;
			charge-dcp-current-microamp = <0x1e8480 0x2dc6c0>;
			charge-cdp-current-microamp = <0x16e360 0x16e360>;
			charge-unknown-current-microamp = <0xf4240 0xf4240>;
			charge-fchg-current-microamp = <0x2dc6c0 0x1e8480>;
			charge-flash-current-microamp = <0x4c4b40 0x2932e0>;
			cap-calib-energy-density-ocv-table = <0x331df0 0x39fbc0 0x3f52f0 0x426030>;
			cap-track-energy-density-ocv-table = <0x33e140 0x38cb10>;
		};
	};

	fragment@2 {
		target = <&cm>;

		__overlay__ {
			compatible = "charger-manager";
			status = "okay";
			cm-name = "battery";
			cm-poll-mode = <0x2>;
			cm-poll-interval = <0x3a98>;
			cm-battery-stat = <0x2>;
			cm-fullbatt-vchkdrop-ms = <0x7530>;
			cm-fullbatt-vchkdrop-volt = <0xea60>;
			cm-fullbatt-capacity = <0x64>;
			cm-cp-taper-current = <0xf4240>;
			cm-chargers = "bq2560x_charger";
			cm-fuel-gauge = "sc27xx-fgu";
			cm-battery-cold = <0xc8>;
			cm-battery-cold-in-minus;
			cm-battery-hot = <0x320>;
			cm-battery-temp-diff = <0x64>;
			cm-charging-max = <0x1499700>;
			cm-discharging-max = <0x2932e0>;
			cm-wdt-interval = <0x3c>;
			cm-shutdown-voltage = <0x2f4d60>;
			cm-tickle-time-out = <0x5dc>;
			cm-one-cap-time = <0x1e>;
			cm-thermal-zone = "board-thmzone";
			cm-charge-voltage-max = <0x632ea0>;
			cm-fast-charge-voltage-max = <0xa037a0>;
			cm-flash-charge-voltage-max = <0xb71b00>;
			cm-charge-voltage-drop = <0xaae60>;
			cm-fast-charge-voltage-drop = <0xaae60>;
			cm-flash-charge-voltage-drop = <0xf4240>;
			monitored-battery = <&bat>;
			cm-capacity-track;
			cm-keep-awake;
			phys = <&hsphy>;
			extcon = <&pmic_typec &pmic_pd>;
		};
	};

	fragment@3 {
		target = <&i2c5>;

		__overlay__ {
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "okay";
		};
	};

	fragment@4 {
		target = <&pmic_fgu>;

		__overlay__ {
			monitored-battery = <&bat>;
			fgu-cap-remap-table = <0x1 0x2 0x3 0x2 0x3 0x2 0x62 0x63 0x2 0x63 0x64 0x3>;
			sprd,calib-resistance-micro-ohms = <0x12f2>;
			sprd,comp-resistance-mohm = <0xb>;
			fgu-capacity-track;
			phys = <&hsphy>;
			sprd,relax-counter-threshold = <0x244>;
			sprd,relax-current-threshold = <0x1e>;
			sprd,capacity-sleep-calibration;
			sprd,capacity-boot-calibration;
			extcon = <&pmic_typec>;
		};
	};

	fragment@5 {
		target = <&cm>;

		__overlay__ {
			cm-chargers = "psc2965_charger";
			extcon = <&pmic_typec>;
		};
	};

	fragment@6 {
		target = <&aon_i2c0>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x186a0>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			psc2965_chg: charger@6b {
				compatible = "psc2965_chg";
				reg = <0x6b>;
				phys = <&hsphy>;
				monitored-battery = <&bat>;
				extcon = <&extcon_gpio>;

				vddvbus: otg-vbus {
					regulator-name = "vddvbus";
				};
			};
		};
	};

	fragment@7 {
		target = <&reserved_memory>;

		__overlay__ {
			protected_reserved: protected-mem@80003000 {
				reg = <0x0 0x80003000 0x0 0x2000>;
			};

			fd_reserved: faceid-mem@ffa70000 {
				reg = <0x0 0xffa70000 0x0 0x500000>;
			};
		};
	};

	fragment@8 {
		target = <&sipc>;

		__overlay__ {
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			sipc_wcn: core@3 {
				compatible = "sprd,sipc";
				reg = <0x3>;
				label = "sipc-wcn";
				mboxes = <&mailbox 0x8 0x0>;
				sprd,smem-info = <0x87240000 0x240000 0x140000>;

				wcn_bt {
					compatible = "sprd,wcn_internal_chip";
					sprd,name = "ttyBT";
					sprd,dst = <0x3>;
					sprd,channel = <0x4>;
					sprd,tx_bufid = <0xb>;
					sprd,rx_bufid = <0xa>;
				};

				wcn_fm {
					compatible = "sprd,wcn_fm_internal_chip";
					sprd,name = "fm";
					sprd,dst = <0x3>;
					sprd,tx_channel = <0x4>;
					sprd,rx_channel = <0x4>;
					sprd,tx_bufid = <0xe>;
					sprd,rx_bufid = <0xd>;
				};
			};

			sipc_gnss: core@4 {
				compatible = "sprd,sipc";
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				reg = <0x4>;
				label = "sipc-gnss";
				mboxes = <&mailbox 0x9 0x0>;
				sprd,smem-info = <0x8749b000 0x11b000 0x32000>;

				sttygnss0: channel@4 {
					compatible = "sprd,spipe";
					reg = <0x4>;
					label = "sttygnss0";
					sprd,ringnr = <0x1>;
					sprd,size-rxbuf = <0x19000>;
					sprd,size-txbuf = <0xc800>;
				};
			};
		};
	};

	fragment@9 {
		target = <&chosen>;

		__overlay__ {
			bootargs_ext = "kvm-arm.mode=none";
		};
	};

	fragment@10 {
		target = <&i2c5>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;
		};
	};

	fragment@11 {
		target = <&hsphy>;

		__overlay__ {
			vdd-supply = <&vddusb33>;
			extcon = <&pmic_typec>;
			sprd,hsphy-device-eye-pattern = <0x613d1c0>;
			sprd,hsphy-host-eye-pattern = <0x4f3d1c0>;
			status = "okay";
		};
	};

	fragment@12 {
		target = <&pmic_typec>;

		__overlay__ {
			extcon = <&extcon_gpio>;
			status = "okay";
		};
	};

	fragment@13 {
		target = <&sdio0>;

		__overlay__ {
			cd-gpios = <&eic_sync 0x23 0x0>;
		};
	};

	fragment@14 {
		target = <&i2c2>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			sec-nfc@27 {
				compatible = "sec-nfc";
				reg = <0x27>;
				clock-names = "nfc_clk", "source", "enable";
				clocks = <&aon_clk 0x4 &ext_26m &aonapb_gate 0x6>;
				sec-nfc,ven-gpio = <&ap_gpio 0x3f 0x0>;
				sec-nfc,firm-gpio = <&ap_gpio 0x3d 0x0>;
				sec-nfc,irq-gpio = <&ap_gpio 0x3e 0x0>;
				sec-nfc,clk-req = <&ap_gpio 0x3c 0x0>;
			};
		};
	};

	fragment@15 {
		target = <&i2c3>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x1>;
			#size-cells = <0x0>;
		};
	};

	fragment@16 {
		target = <&i2c4>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			stm_vl53l0: vl53l0@52 {
				compatible = "st,stmvl53l0";
				reg = <0x52>;
				reset_gpios = <0xa8>;
				irq_gpios = <0xa9>;
				interrupt-parent = <&ap_gpio>;
				interrupts = <0xa9 0x8>;
			};
		};
	};

	fragment@17 {
		target = <&sprd_headset>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@18 {
		target = <&pdm_dmic>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@19 {
		target = <&agdsp_domain>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@20 {
		target = <&sound_vbc_v4_sprd_codec>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@21 {
		target = <&vddldo0>;

		__overlay__ {
			regulator-always-on;
		};
	};

	fragment@22 {
		target = <&dpu>;

		__overlay__ {
			sprd,logo-memory = <&logo_reserved>;
			sprd,backlight = <&pwm_backlight>;
		};
	};

	fragment@23 {
		target = <&ddr_dfs>;

		__overlay__ {
			sprd-scene = "boost", "lcdon", "lcdoff", "camlow", "camhigh", "camveryhigh", "faceid", "top", "boot-opt";
			sprd-freq = <0x535 0x300 0x100 0x535 0x535 0x600 0x535 0x600 0x600>;
		};
	};

	fragment@24 {
		target = <&pin_controller>;

		__overlay__ {
			pinctrl-names = "gpio_8", "gpio_22", "gpio_24", "gpio_25", "gpio_26", "gpio_124", "gpio_175";
			pinctrl-0 = <&gpio_8>;
			pinctrl-1 = <&gpio_22>;
			pinctrl-2 = <&gpio_24>;
			pinctrl-3 = <&gpio_25>;
			pinctrl-4 = <&gpio_26>;
			pinctrl-5 = <&gpio_124>;
			pinctrl-6 = <&gpio_175>;

			gpio_8: rfctl16 {
				pins = "QOGIRL6_RFCTL16";
				function = "func4";
			};

			gpio_22: rfctl3 {
				pins = "QOGIRL6_RFCTL3";
				function = "func4";
			};

			gpio_24: rfctl5 {
				pins = "QOGIRL6_RFCTL5";
				function = "func4";
			};

			gpio_25: rfctl6 {
				pins = "QOGIRL6_RFCTL6";
				function = "func4";
			};

			gpio_26: rfctl7 {
				pins = "QOGIRL6_RFCTL7";
				function = "func4";
			};

			gpio_124: keyin0 {
				pins = "QOGIRL6_KEYIN0";
				function = "func4";
			};

			gpio_175: bt_rfctl2 {
				pins = "QOGIRL6_BT_RFCTL2";
				function = "func4";
			};
		};
	};

	fragment@25 {
		target = <&dmabuf>;

		__overlay__ {
			fd-reserved {
				label = "carveout_fd";
				memory-region = <&fd_reserved>;
			};

			protected-reserved {
				label = "protected";
				memory-region = <&protected_reserved>;
			};
		};
