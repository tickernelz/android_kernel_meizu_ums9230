			sdp-jeita-temp-table = <0x3e8 0x406 0x0 0x423920 0x47e 0x49c 0x7a120 0x423920 0x5aa 0x58c 0x7a120 0x423920 0x640 0x622 0x7a120 0x3e8fa0>;
			cdp-jeita-temp-table = <0x3e8 0x406 0x0 0x423920 0x47e 0x49c 0xaae60 0x423920 0x5aa 0x58c 0x16e360 0x423920 0x640 0x622 0xaae60 0x3e8fa0>;
			unknown-jeita-temp-table = <0x3e8 0x406 0x0 0x423920 0x47e 0x49c 0xaae60 0x423920 0x5aa 0x58c 0xf4240 0x423920 0x640 0x622 0xaae60 0x3e8fa0>;
