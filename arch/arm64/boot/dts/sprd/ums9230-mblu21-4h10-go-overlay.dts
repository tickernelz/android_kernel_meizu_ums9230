	fragment@3 {
		target = <&cm>;

		__overlay__ {
			compatible = "charger-manager";
			status = "okay";
			cm-name = "battery";
			cm-poll-mode = <0x2>;
			cm-poll-interval = <0x3a98>;
			cm-battery-stat = <0x2>;
			cm-fullbatt-vchkdrop-ms = <0x7530>;
			cm-fullbatt-vchkdrop-volt = <0xea60>;
			cm-fullbatt-capacity = <0x64>;
			cm-cp-taper-current = <0xf4240>;
			cm-chargers = "bq2560x_charger";
			cm-charge-pumps = "bq2597x-standalone";
			cm-wireless-chargers = "nu1619_wireless_charger";
			cm-wireless-charge-pump-converters = "hl1506_cp_converter";
			cm-fuel-gauge = "sc27xx-fgu";
			cm-battery-cold = <0xc8>;
			cm-battery-cold-in-minus;
			cm-battery-hot = <0x320>;
			cm-battery-temp-diff = <0x64>;
			cm-charging-max = <0x1499700>;
			cm-discharging-max = <0x2932e0>;
			cm-wdt-interval = <0x3c>;
			cm-shutdown-voltage = <0x2f4d60>;
			cm-tickle-time-out = <0x5dc>;
			cm-one-cap-time = <0x1e>;
			cm-thermal-zone = "board-thmzone";
			cm-charge-voltage-max = <0x632ea0>;
			cm-fast-charge-voltage-max = <0xa037a0>;
			cm-flash-charge-voltage-max = <0xb71b00>;
			cm-charge-voltage-drop = <0xaae60>;
			cm-fast-charge-voltage-drop = <0xaae60>;
			cm-flash-charge-voltage-drop = <0xf4240>;
			sprd,support-fchg;
			sprd,support-pd-pps;
			sprd,pd-fixed-max-microwatt = <0x112a880>;
			monitored-battery = <&bat>;
			cm-capacity-track;
			cm-keep-awake;
			phys = <&hsphy>;
			pd-extcon-enable;
			extcon = <&pmic_typec &pmic_pd>;
		};
	};

	fragment@4 {
		target = <&i2c5>;

		__overlay__ {
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "okay";

			bq2560x_chg: charger@6b {
				compatible = "ti,bq2560x_chg";
				reg = <0x6b>;
				monitored-battery = <&bat>;
				irq-gpio = <&ap_gpio 0x73 0x1>;

				vddvbus: otg-vbus {
					regulator-name = "vddvbus";
				};
			};

			bq2597x_chg: charger@65 {
				compatible = "ti,bq2597x-standalone";
				reg = <0x65>;
				irq-gpio = <&ap_gpio 0x7e 0x1>;
				ti,bq2597x,bus-therm-disable = <0x1>;
				ti,bq2597x,regulation-disable = <0x1>;
				ti,bq2597x,bat-ovp-threshold = <0x1130>;
				ti,bq2597x,bat-ovp-alarm-threshold = <0x10f4>;
				ti,bq2597x,bat-ocp-threshold = <0x157c>;
				ti,bq2597x,bat-ocp-alarm-threshold = <0x1388>;
				ti,bq2597x,bus-ovp-threshold = <0x2cec>;
				ti,bq2597x,bus-ovp-alarm-threshold = <0x2904>;
				ti,bq2597x,bus-ocp-threshold = <0xbb8>;
				ti,bq2597x,bus-ocp-alarm-threshold = <0xa8c>;
				ti,bq2597x,bat-ucp-alarm-threshold = <0x3e8>;
				ti,bq2597x,bat-therm-threshold = <0x15>;
				ti,bq2597x,bus-therm-threshold = <0x15>;
				ti,bq2597x,die-therm-threshold = <0xc8>;
				ti,bq2597x,ac-ovp-threshold = <0xd>;
				ti,bq2597x,sense-resistor-mohm = <0x5>;
				ti,bq2597x,adc-sample-bits = <0xd>;
				ti,bq2597x,ibat-regulation-threshold = <0x12c>;
				ti,bq2597x,vbat-regulation-threshold = <0x64>;
				ti,bq2597x,vdrop-threshold = <0x190>;
				ti,bq2597x,vdrop-deglitch = <0x1388>;
				ti,bq2597x,ss-timeout = <0x186a0>;
				ti,bq2597x,watchdog-timer = <0x7530>;
			};

			hl1506_cp_converter: charger@1b {
				compatible = "halo,hl1506_cp_converter";
				reg = <0x1b>;
				chg_pump_en_gpio = <&ap_gpio 0x93 0x0>;
			};

			nu1619_rx: charger@61 {
				compatible = "nuvolta,wl_charger_nu1619";
				reg = <0x61>;
				phys = <&hsphy>;
				rx,irq_gpio = <&ap_gpio 0x92 0x1>;
				switch_chg_en_gpio = <&ap_gpio 0xab 0x0>;
				switch_flag_en_gpio = <&ap_gpio 0xb0 0x0>;
			};
		};
	};

	fragment@5 {
		target = <&pmic_fgu>;

		__overlay__ {
			monitored-battery = <&bat>;
			fgu-cap-remap-table = <0x1 0x2 0x3 0x2 0x3 0x2 0x62 0x63 0x2 0x63 0x64 0x3>;
			sprd,calib-resistance-micro-ohms = <0x12f2>;
			sprd,comp-resistance-mohm = <0xb>;
			fgu-capacity-track;
			phys = <&hsphy>;
			sprd,relax-counter-threshold = <0x244>;
			sprd,relax-current-threshold = <0x1e>;
			sprd,capacity-sleep-calibration;
			sprd,capacity-boot-calibration;
		};
	};

	fragment@6 {
		target = <&pmic_fchg>;

		__overlay__ {
			status = "okay";
			sprd,input-voltage-microvolt = <0x4c4b40>;
		};
	};

	fragment@7 {
		target = <&pmic_pd>;

		__overlay__ {
			status = "okay";
			sprd,syscon-aon-apb = <&aon_apb_regs>;

			usb_con: connector {
				compatible = "usb-c-connector";
				label = "USB-C";
				power-role = "dual";
				try-power-role = "sink";
				source-pdos = <0x4019028>;
				sink-pdos = <0x401912c 0xc0dc213c>;
				op-sink-microwatt = <0x989680>;
			};
		};
	};

	fragment@8 {
		target = <&chosen>;

		__overlay__ {
			bootargs_ext = "kvm-arm.mode=none";
		};
	};

	fragment@9 {
		target = <&i2c0>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			sensor_main: sensor-main@20 {
				compatible = "sprd,sensor-main";
				reg = <0x20>;
				clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_76m8", "clk_48m", "clk_26m";
				clocks = <&mm_clk 0x2 &mm_gate 0xd &pll1 0x4 &pll1 0x10 &pll1 0x5 &ext_26m>;
				vddio-supply = <&vddcamio>;
				vddcama-supply = <&vddcama0>;
				dvdd-gpios = <&ap_gpio 0x89 0x0>;
				vddcammot-supply = <&vddcammot>;
				reset-gpios = <&ap_gpio 0x2d 0x0>;
				power-down-gpios = <&ap_gpio 0x2f 0x0>;
				sprd,phyid = <0x0>;
				csi = <&csi0>;
				power-domains = <&mm_domain>;
			};

			sensor_sub: sensor-sub@5a {
				compatible = "sprd,sensor-sub";
				reg = <0x5a>;
				clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_76m8", "clk_48m", "clk_26m";
				clocks = <&mm_clk 0x2 &mm_gate 0xd &pll1 0x4 &pll1 0x10 &pll1 0x5 &ext_26m>;
				vddio-supply = <&vddcamio>;
				vddcama-supply = <&vddcama0>;
				dvdd-gpios = <&ap_gpio 0x89 0x0>;
				vddcammot-supply = <&vddcammot>;
				reset-gpios = <&ap_gpio 0x2c 0x0>;
				power-down-gpios = <&ap_gpio 0x2e 0x0>;
				sprd,phyid = <0x2>;
				csi = <&csi0>;
				power-domains = <&mm_domain>;
			};
		};
	};

	fragment@10 {
		target = <&i2c1>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			sensor_main2: sensor-main2@20 {
				compatible = "sprd,sensor-main2";
				reg = <0x20>;
				clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_76m8", "clk_48m", "clk_26m";
				clocks = <&mm_clk 0x3 &mm_gate 0xc &pll1 0x4 &pll1 0x10 &pll1 0x5 &ext_26m>;
				vddio-supply = <&vddcamio>;
				vddcama-supply = <&vddcama1>;
				vddcamd-supply = <&vddcamd0>;
				vddcammot-supply = <&vddcammot>;
				avdd-gpios = <&ap_gpio 0xa 0x0>;
				mot-gpios = <&ap_gpio 0x58 0x0>;
				reset-gpios = <&ap_gpio 0x29 0x0>;
				power-down-gpios = <&ap_gpio 0x28 0x0>;
				sprd,phyid = <0x4>;
				csi = <&csi1>;
				power-domains = <&mm_domain>;
			};
		};
	};

	fragment@11 {
		target = <&i2c5>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			flash_ic: flash-ic@63 {
				compatible = "sprd,flash-ocp8137";
				reg = <0x63>;
				sprd,flash-ic = <0x1fc9>;
				sprd,torch = <0x1>;
				sprd,preflash = <0x1>;
				sprd,highlight = <0x1>;
				sprd,torch-level = <0x80>;
				sprd,preflash-level = <0x80>;
				sprd,highlight-level = <0x80>;
				sprd,lvfm-enable = <0x1>;
				flash-torch-en-gpios = <&ap_gpio 0x20 0x0>;
				flash-chip-en-gpios = <&ap_gpio 0x8a 0x0>;
				flash-en-gpios = <&ap_gpio 0x8b 0x0>;
				flash-sync-gpios = <&ap_gpio 0x79 0x0>;
			};
		};
	};

	fragment@12 {
		target = <&i2c6>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			sensor_sub2: sensor-sub2@6e {
				compatible = "sprd,sensor-sub2";
				reg = <0x6e>;
				clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_76m8", "clk_48m", "clk_26m";
				clocks = <&mm_clk 0x4 &mm_gate 0xb &pll1 0x4 &pll1 0x10 &pll1 0x5 &ext_26m>;
				vddio-supply = <&vddcamio>;
				avdd-gpios = <&ap_gpio 0x82 0x0>;
				vddcamd-supply = <&vddcamd1>;
				vddcammot-supply = <&vddcammot>;
				mot-gpios = <&ap_gpio 0x70 0x0>;
				reset-gpios = <&ap_gpio 0x72 0x0>;
				sprd,phyid = <0x3>;
				csi = <&csi2>;
			};
		};
	};

	fragment@13 {
		target = <&hsphy>;

		__overlay__ {
			vdd-supply = <&vddusb33>;
			extcon = <&extcon_gpio>;
			sprd,hsphy-device-eye-pattern = <0x613d1c0>;
			sprd,hsphy-host-eye-pattern = <0x4f3d1c0>;
			status = "okay";
		};
	};

	fragment@14 {
		target = <&usb>;

		__overlay__ {
			extcon = <&extcon_gpio &pmic_typec>;
			vbus-supply = <&vddvbus>;
			status = "okay";
		};
	};

	fragment@15 {
		target = <&sdio0>;

		__overlay__ {
			cd-gpios = <&eic_sync 0x23 0x0>;
		};
	};

	fragment@16 {
		target = <&sdio1>;

		__overlay__ {
			sprd,phy-delay-sd-uhs-sdr104 = <0x7f 0x61 0x5e 0x5e>;
			sprd,phy-delay-sd-uhs-sdr50 = <0x7f 0x7f 0x8f 0x8f>;
			sd-uhs-sdr104;
			sd-uhs-sdr50;
			bus-width = <0x4>;
			sprd,name = "sdio_wifi";
			sprd,sdio-adma;
			no-sd;
			no-mmc;
			status = "okay";
		};
	};

	fragment@17 {
		target = <&sdio3>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@18 {
		target = <&i2c2>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			sec-nfc@27 {
				compatible = "sec-nfc";
				reg = <0x27>;
				clock-names = "nfc_clk", "source", "enable";
				clocks = <&aon_clk 0x4 &ext_26m &aonapb_gate 0x6>;
				sec-nfc,ven-gpio = <&ap_gpio 0x3f 0x0>;
				sec-nfc,firm-gpio = <&ap_gpio 0x3d 0x0>;
				sec-nfc,irq-gpio = <&ap_gpio 0x3e 0x0>;
				sec-nfc,clk-req = <&ap_gpio 0x3c 0x0>;
			};

			ucp1301_rcv: ucp1301@58 {
				compatible = "unisoc,ucp1301-rcv";
				reg = <0x58>;
				reset-gpios = <&ap_gpio 0xac 0x0>;
				#sound-dai-cells = <0x1>;
			};
		};
	};

	fragment@19 {
		target = <&i2c3>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x1>;
			#size-cells = <0x0>;
		};
	};

	fragment@20 {
		target = <&i2c4>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			ucp1301_spk: ucp1301@58 {
				compatible = "unisoc,ucp1301-spk";
				reg = <0x58>;
				reset-gpios = <&ap_gpio 0xa7 0x0>;
				#sound-dai-cells = <0x1>;
			};

			stm_vl53l0: vl53l0@52 {
				compatible = "st,stmvl53l0";
				reg = <0x52>;
				reset_gpios = <0xa8>;
				irq_gpios = <0xa9>;
				interrupt-parent = <&ap_gpio>;
				interrupts = <0xa9 0x8>;
			};
		};
	};

	fragment@21 {
		target = <&aon_i2c0>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0xf4240>;
		};
	};

	fragment@22 {
		target = <&sprd_headset>;

		__overlay__ {
			status = "okay";
			extcon = <&pmic_typec>;
			mic-gpios = <&ap_gpio 0xaf 0x0>;
			lr-gpios = <&ap_gpio 0xae 0x0>;
			sprd,3pole-adc-threshold = <0x70>;
		};
	};

	fragment@23 {
		target = <&pdm_dmic>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@24 {
		target = <&agdsp_domain>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@25 {
		target = <&sound_vbc_v4_sprd_codec>;

		__overlay__ {
			status = "okay";
			sprd-audio-card,routing = "HPMIC Pin", "HP Mic Jack", "MIC Pin", "Mic Jack", "MIC2 Pin", "Aux Mic Jack", "HeadPhone Jack", "HP Pin", "Ext Spk", "SPK Pin", "UCP1301 SPK ON", "SPK Pin", "Ext Spk", "UCP1301 SPK", "PDM DMIC2 ON", "SPK Pin", "Ext Spk", "PDM_DMIC2", "DMIC Pin", "DMic Jack", "DMIC1 Pin", "DMic1 Jack", "Ext Ear", "EAR Pin", "UCP1301 RCV ON", "EAR Pin", "Ext Ear", "UCP1301 RCV";

			sprd-audio-card,dai-link@53 {
				ignore-suspend = <0x1>;
				link-name = "BE_NORMAL_AP01_UCPSPK";
				stream-name = "BE_ST_NORMAL_AP01_UCPSPK";
				no-pcm = <0x1>;
				dpcm-playback = <0x1>;
				be-id = <0x0>;
				dai-format = "i2s";

				plat {
					sound-dai = <&sprd_route_pcm>;
				};

				cpu {
					sound-dai = <&vbc_v4 0x1f>;
				};

				codec {
					sound-dai = <&ucp1301_spk 0x0>;
				};
			};

			sprd-audio-card,dai-link@55 {
				ignore-suspend = <0x1>;
				link-name = "BE_NORMAL_AP01_UCPRCV";
				stream-name = "BE_ST_NORMAL_AP01_UCPRCV";
				no-pcm = <0x1>;
				dpcm-playback = <0x1>;
				be-id = <0x0>;
				dai-format = "i2s";

				plat {
					sound-dai = <&sprd_route_pcm>;
				};

				cpu {
					sound-dai = <&vbc_v4 0x1f>;
				};

				codec {
					sound-dai = <&ucp1301_rcv 0x0>;
				};
			};

			sprd-audio-card,dai-link@81 {
				ignore-suspend = <0x1>;
				link-name = "BE_PDM_DMIC";
				stream-name = "BE_ST_PDM_DMIC";
				no-pcm = <0x1>;
				dpcm-capture = <0x1>;
				be-id = <0x0>;

				plat {
					sound-dai = <&sprd_route_pcm>;
				};

				cpu {
					sound-dai = <&vbc_v4 0x1f>;
				};

				codec {
					sound-dai = <&pdm_dmic 0x0>;
				};
			};
		};
	};

	fragment@26 {
		target = <&vddldo0>;

		__overlay__ {
			regulator-always-on;
		};
	};

	fragment@27 {
		target = <&panel>;

		__overlay__ {
			sprd,backlight = <&pwm_backlight>;
			avdd-gpio = <&ap_gpio 0x87 0x0>;
			avee-gpio = <&ap_gpio 0x88 0x0>;
			reset-gpio = <&ap_gpio 0x32 0x0>;
		};
	};

	fragment@28 {
		target = <&dpu>;

		__overlay__ {
			sprd,logo-memory = <&logo_reserved>;
			sprd,backlight = <&pwm_backlight>;
		};
	};

	fragment@29 {
		target = <&ddr_dfs>;

		__overlay__ {
			sprd-scene = "boost", "lcdon", "lcdoff", "camlow", "camhigh", "camveryhigh", "faceid", "top", "boot-opt";
			sprd-freq = <0x535 0x300 0x100 0x535 0x535 0xbacd 0x535 0xbacd 0xbacd>;
		};
	};

	fragment@30 {
		target = <&pin_controller>;

		__overlay__ {
			pinctrl-names = "gpio_8", "gpio_22", "gpio_24", "gpio_25", "gpio_26", "gpio_124", "gpio_175";
			pinctrl-0 = <&gpio_8>;
			pinctrl-1 = <&gpio_22>;
			pinctrl-2 = <&gpio_24>;
			pinctrl-3 = <&gpio_25>;
			pinctrl-4 = <&gpio_26>;
			pinctrl-5 = <&gpio_124>;
			pinctrl-6 = <&gpio_175>;

			gpio_8: rfctl16 {
				pins = "QOGIRL6_RFCTL16";
				function = "func4";
			};

			gpio_22: rfctl3 {
				pins = "QOGIRL6_RFCTL3";
				function = "func4";
			};

			gpio_24: rfctl5 {
				pins = "QOGIRL6_RFCTL5";
				function = "func4";
			};

			gpio_25: rfctl6 {
				pins = "QOGIRL6_RFCTL6";
				function = "func4";
			};

			gpio_26: rfctl7 {
				pins = "QOGIRL6_RFCTL7";
				function = "func4";
			};

			gpio_124: keyin0 {
				pins = "QOGIRL6_KEYIN0";
				function = "func4";
			};

			gpio_175: bt_rfctl2 {
				pins = "QOGIRL6_BT_RFCTL2";
				function = "func4";
			};
		};
	};

	fragment@31 {
		target = <&dmabuf>;

		__overlay__ {
			fd-reserved {
				label = "carveout_fd";
				memory-region = <&fd_reserved>;
			};

			protected-reserved {
				label = "protected";
				memory-region = <&protected_reserved>;
			};
		};
	};

	fragment@32 {
		target = <&adi_bus>;

		__overlay__ {
			sprd,hw-channels = <0x2 0x18cc 0x3 0x18cc 0xd 0x1854 0xf 0x1874 0x11 0x1844 0x13 0x1844 0x15 0x1864 0x1e 0x1820 0x20 0x197c 0x21 0x1988 0x23 0x19b8 0x27 0x19ac>;
			sprd,hw-channels0 = <0x2 0x18cc 0x3 0x18cc 0xd 0x1874 0xf 0x1874 0x11 0x1844 0x13 0x1854 0x15 0x1864 0x1e 0x1820 0x20 0x197c 0x21 0x1988 0x23 0x19b8 0x27 0x19ac>;
			sprd,hw-channels1 = <0x2 0x18cc 0x3 0x18cc 0xd 0x1854 0xf 0x1874 0x11 0x1844 0x13 0x1844 0x15 0x1864 0x1e 0x1820 0x20 0x197c 0x21 0x1988 0x23 0x19b8 0x27 0x19ac>;
		};
	};
};
