/dts-v1/;
/plugin/;

/ {
	model = "Spreadtrum UMS9230 4H10 Board";
	compatible = "sprd,ums9230-4h10-go";
	sprd,sc-id = "ums9230 4h10 go";
	sprd,board_id = <0x490000>;

	fragment {
		target-path = "/";

		__overlay__ {
			lcds {
