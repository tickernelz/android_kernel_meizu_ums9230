					sprd,sleep-out-command = [13 78 00 01 11 13 32 00 01 29];
					sprd,sr-width = <0x2d0>;
					sprd,sr-height = <0x640>;

					display-timings {
						native-mode = <&nt36672e_truly_timing0>;

						nt36672e_truly_timing0: timing0 {
							clock-frequency = <0xa9c1080>;
							hactive = <0x438>;
							vactive = <0x968>;
							hback-porch = <0x23>;
							hfront-porch = <0x46>;
							vback-porch = <0x20>;
							vfront-porch = <0x20>;
							hsync-len = <0xa>;
							vsync-len = <0x2>;
						};
					};
				};

				lcd_dummy_mipi_hd: lcd_dummy_mipi_hd {
					sprd,dsi-work-mode = <0x1>;
					sprd,dsi-lane-number = <0x4>;
					sprd,dsi-color-format = "rgb888";
					sprd,initial-command = [13 78 00 01 11 13 64 00 01 29];
					sprd,sleep-in-command = [13 0a 00 01 28 13 78 00 01 10];
					sprd,sleep-out-command = [13 78 00 01 11 13 64 00 01 29];

					display-timings {
						native-mode = <&dummy_timing0>;

						dummy_timing0: timing0 {
							clock-frequency = <0x493e000>;
							hactive = <0x2d0>;
							vactive = <0x500>;
							hback-porch = <0x3c>;
							hfront-porch = <0x50>;
							vback-porch = <0xc>;
							vfront-porch = <0x26>;
							hsync-len = <0x3c>;
							vsync-len = <0x4>;
						};
					};
				};
			};

			sprd_marlin3: sprd-marlin3 {
				compatible = "unisoc,marlin3lite_sdio";
				m2-wakeup-ap-gpios = <&ap_gpio 0x35 0x1>;
				reset-gpios = <&ap_gpio 0xb1 0x1>;
				enable-gpios = <&ap_gpio 0x74 0x1>;
				m2-to-ap-irq-gpios = <&ap_gpio 0x34 0x1>;
				avdd12-supply = <&vddwcn>;
				avdd33-supply = <&vddwifipa>;
				dcxo18-supply = <&vddsim2>;
				clock-names = "clk_32k", "source", "enable";
				clocks = <&aon_clk 0x4 &ext_32k &aonapb_gate 0x6>;
				memory-region = <&wcn_reserved>;
				extcon = <&sdio1>;
				sdhci-name = <&sdio1>;
				sprd,btwf-file-name = "/dev/block/by-name/wcnmodem";
				sprd,gnss-file-name = "/vendor/firmware/gnssmodem.bin";
				adma-tx;
				adma-rx;
				avdd12-parent-bound-chip = <0x1a4c 0x1 0x0 0x1>;
				avdd12-bound-wbreq = <0x1ac8 0x1000 0x0 0x1000>;
				avdd33-bound-wbreq = <0x1acc 0x4 0x0 0x4>;

				wcn-dump {
					btwf-dump {
						sprd,sdio-reg = <0x40140000 0x10000 0x0 0x20>;
						sprd,aon-ahb = <0x40880000 0x54 0x0 0x1>;
						sprd,aon-apb = <0x4083c000 0x354 0x0 0x1>;
						sprd,btwf-ahb = <0x40130000 0x400 0x0 0x1>;
						sprd,btwf-apb = <0x40088000 0x28c 0x0 0x1>;
						sprd,aon-clk = <0x40844200 0x144 0x0 0x1>;
						sprd,pre-div-clk = <0x40844000 0x48 0x0 0x1>;
						sprd,wifi-aon-reg = <0x400f0000 0x120 0x0 0x2>;
						sprd,wifi-rtn_pd_mac = <0x400f1000 0xd100 0x0 0x2>;
						sprd,wifi-ram = <0x40300000 0x4a800 0x0 0x2>;
						sprd,wifi-glb-reg = <0x400a0000 0x58 0x0 0x2>;
						sprd,wifi-phy-top-reg = <0x400b0000 0x388 0x0 0x2>;
						sprd,wifi-phy-tx11a-reg = <0x400b1000 0x154 0x0 0x2>;
						sprd,wifi-phy-rx11a-reg = <0x400b2000 0xa8c 0x0 0x2>;
						sprd,wifi-phy-11b-reg = <0x400b3000 0xb0 0x0 0x2>;
						sprd,wifi-rfif-reg = <0x400b4000 0xa70 0x0 0x2>;
						sprd,wifi-dfe-reg = <0x400b7000 0x618 0x0 0x2>;
						sprd,fm-reg = <0x40098000 0xabc 0x0 0x8>;
						sprd,bt-acc = <0x40240000 0x8f4 0x0 0x4>;
						sprd,bt-jal = <0x40246000 0x738 0x0 0x4>;
						sprd,bt-hab = <0x40248000 0xa0 0x0 0x4>;
						sprd,bt-lejal = <0x4024a000 0x21c 0x0 0x4>;
						sprd,bt-modem = <0x4024f000 0x310 0x0 0x4>;
						sprd,bt-cmd-buf = <0x40200000 0x200 0x0 0x4>;
						sprd,bt-event-buf = <0x40204000 0x200 0x0 0x4>;
						sprd,bt-lmp-tx-buf = <0x40208000 0x12a4 0x0 0x4>;
						sprd,bt-lmp-rx-buf = <0x40200c00 0xb744 0x0 0x4>;
						sprd,bt-acl-tx-buf = <0x40210000 0x3000 0x0 0x4>;
						sprd,bt-acl-rx-buf = <0x40214000 0x3000 0x0 0x4>;
						sprd,bt-sco-tx-buf = <0x40218000 0x2d0 0x0 0x4>;
						sprd,bt-sco-rx-buf = <0x4021c000 0x5c0 0x0 0x4>;
						sprd,bt-bb-tx-buf = <0x40241000 0x400 0x0 0x4>;
						sprd,bt-bb-rx-buf = <0x40242000 0x400 0x0 0x4>;
						sprd,btwf-ram = <0x100000 0xe7400 0x40400000 0x1>;
					};

					gnss-dump {
						sprd,gnss-ctl-base-aon-clk = <0x40844200 0x144 0x0 0x10>;
						sprd,gnss-base-aon-apb = <0x4083c000 0x354 0x0 0x10>;
						sprd,gnss-te-mem = <0x40e40000 0x30000 0x0 0x10>;
						sprd,gnss-dram = <0x40a80000 0x30000 0x0 0x10>;
						sprd,gnss-iram = <0x40a50000 0x2b000 0x0 0x10>;
					};
				};

				sprd-mtty {
					compatible = "sprd,mtty";
					sprd,name = "ttyBT";
				};

				sprd-fm {
					compatible = "sprd,marlin3-fm";
					sprd,name = "sprd-fm";
				};

				wlan {
					compatible = "sprd,sc2355-sdio-wifi";
				};

				gnss {
					compatible = "sprd,gnss";
				};
			};

			fingerprint@0 {
				compatible = "microarray,afs121";
				fpint-gpios = <&eic_async 0x1d 0x0>;
			};

			gpio-keys {
				compatible = "gpio-keys";

				key-volumedown {
					label = "Volume Down Key";
					linux,code = <0x72>;
					gpios = <&ap_gpio 0x7c 0x1>;
					debounce-interval = <0x2>;
					wakeup-source;
				};

				key-volumeup {
					label = "Volume Up Key";
					linux,code = <0x73>;
					gpios = <&pmic_eic 0x4 0x0>;
					debounce-interval = <0x2>;
					wakeup-source;
				};

