				sprd,file-name = "/dev/block/platform/soc/soc:ap-apb/201d0000.sdio/by-name/gnssmodem";
				sprd,file-name-ext = "/dev/block/platform/soc/soc:ap-apb/201d0000.sdio/by-name/gnssmodem";
				sprd,file-name-ufs = "/dev/block/platform/soc/soc:ap-apb/20200000.ufs/by-name/gnssmodem";
				sprd,file-name-ext-ufs = "/dev/block/platform/soc/soc:ap-apb/20200000.ufs/by-name/gnssmodem";
				sprd,file-length = <0x180000>;
				sprd,apcp-sync-addr = <0x1ffc00>;
				sprd,wcn-sipc-ver = <0x1>;
				vddwcn-supply = <&vddwcn>;
				dcxo1v8-supply = <&vddsim2>;
				merlion-chip-en-gpios = <&ap_gpio 0x76 0x0>;
				merlion-rst-gpios = <&ap_gpio 0x75 0x0>;
				xtal-26m-type-sel-gpios = <&ap_gpio 0xad 0x0>;
				#address-cells = <0x1>;
				#size-cells = <0x1>;
				nvmem-cells = <&wcn_alpha>;
				nvmem-cell-names = "gnss_efuse_blk0";

				wcn-dump {
					gnss-dump {
						sprd,aon-control = <0x40c00000 0x64 0x11000000 0x0>;
						sprd,aon-ahb-sys = <0x40b18000 0x42c 0x11000000 0x0>;
						sprd,aon-apb-peri = <0x40bc8000 0x2e4 0x11000000 0x0>;
						sprd,aon-wcn-gnss-clk = <0x40bd8000 0x54 0x11000000 0x0>;
						sprd,gnss-iram-pchannel = <0x40e40000 0x20000 0x11000000 0x0>;
						sprd,gnss-iram = <0x40a50000 0x8000 0x11000000 0x0>;
						sprd,gnss-sipc-buff = <0x88240000 0x40000 0x0 0x0>;
						sprd,gnss-share-mem = <0x0 0x200000 0x87600000 0x0>;
					};
				};
			};

			gnss_common_ctl {
				compatible = "sprd,gnss";
				sprd,name = "gnss_common_ctl";
			};

			fingerprint@0 {
				compatible = "microarray,afs121";
				fpint-gpios = <&eic_async 0x1d 0x0>;
			};

			gpio-keys {
				compatible = "gpio-keys";

				key-volumedown {
					label = "Volume Down Key";
					linux,code = <0x72>;
					gpios = <&ap_gpio 0x7c 0x1>;
					debounce-interval = <0x2>;
					wakeup-source;
				};

				key-volumeup {
					label = "Volume Up Key";
					linux,code = <0x73>;
					gpios = <&pmic_eic 0x4 0x0>;
					debounce-interval = <0x2>;
					wakeup-source;
				};

				key-power {
					label = "Power Key";
					linux,code = <0x74>;
					gpios = <&pmic_eic 0x1 0x1>;
					debounce-interval = <0x2>;
					wakeup-source;
				};
			};

			audio-voice-trig {
				status = "disable";
				compatible = "sprd,voice_trig";
				irq_gpio = <&ap_gpio 0xa9 0x0>;
			};

			sprd-uid {
				compatible = "sprd,uid";
				nvmem-cells = <&uid_start &uid_end>;
				nvmem-cell-names = "uid_start", "uid_end";
			};
		};
	};

	fragment@0 {
		target = <&spi3>;

		__overlay__ {
			status = "ok";
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			touchpanel@0 {
				status = "okay";
				reg = <0x0>;
				spi-max-frequency = <0x927c00>;
				compatible = "novatek,NVT-ts-spi", "adaptive-touchscreen";
				novatek,reset-gpio = <&ap_gpio 0x91 0x0>;
				novatek,irq-gpio = <&eic_async 0x10 0x0>;
				novatek,resolution = <0x2d0 0x64c>;
			};
		};
	};

