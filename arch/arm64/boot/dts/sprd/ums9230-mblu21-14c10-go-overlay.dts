	fragment@2 {
		target = <&cm>;

		__overlay__ {
			compatible = "charger-manager";
			status = "okay";
			cm-name = "battery";
			cm-poll-mode = <0x2>;
			cm-poll-interval = <0x3a98>;
			cm-battery-stat = <0x2>;
			cm-fullbatt-vchkdrop-ms = <0x7530>;
			cm-fullbatt-vchkdrop-volt = <0xea60>;
			cm-fullbatt-capacity = <0x64>;
			cm-cp-taper-current = <0xf4240>;
			cm-chargers = "sgm41516_charger";
			cm-fuel-gauge = "sc27xx-fgu";
			cm-battery-cold = <0xc8>;
			cm-battery-cold-in-minus;
			cm-battery-hot = <0x320>;
			cm-battery-temp-diff = <0x64>;
			cm-charging-max = <0x1499700>;
			cm-discharging-max = <0x2932e0>;
			cm-wdt-interval = <0x3c>;
			cm-shutdown-voltage = <0x2f4d60>;
			cm-tickle-time-out = <0x5dc>;
			cm-one-cap-time = <0x1e>;
			cm-thermal-zone = "board-thmzone";
			cm-charge-voltage-max = <0x632ea0>;
			cm-fast-charge-voltage-max = <0xa037a0>;
			cm-charge-voltage-drop = <0xaae60>;
			cm-fast-charge-voltage-drop = <0xaae60>;
			sprd,support-fchg;
			sprd,pd-fixed-max-microwatt = <0x112a880>;
			monitored-battery = <&bat>;
			cm-capacity-track;
			cm-keep-awake;
			phys = <&hsphy>;
			pd-extcon-enable;
			extcon = <&pmic_typec &pmic_pd>;
		};
	};

	fragment@3 {
		target = <&i2c4>;

		__overlay__ {
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "okay";

			sgm41516_chg: charger@6b {
				compatible = "Sgm,sgm41516_chg";
				reg = <0x6b>;
				monitored-battery = <&bat>;

				vddvbus: otg-vbus {
					regulator-name = "vddvbus";
				};
			};
		};
	};

	fragment@4 {
		target = <&pmic_fgu>;

		__overlay__ {
			monitored-battery = <&bat>;
			fgu-cap-remap-table = <0x1 0x2 0x3 0x2 0x3 0x2 0x62 0x63 0x2 0x63 0x64 0x3>;
			sprd,calib-resistance-micro-ohms = <0x2710>;
			sprd,comp-resistance-mohm = <0x14>;
			fgu-capacity-track;
			phys = <&hsphy>;
			sprd,relax-counter-threshold = <0x244>;
			sprd,relax-current-threshold = <0x1e>;
			sprd,capacity-sleep-calibration;
			sprd,capacity-boot-calibration;
			io-channels = <&pmic_adc 0x4 &pmic_adc 0xe>;
			io-channel-names = "bat-temp", "charge-vol";
		};
	};

	fragment@5 {
		target = <&pmic_fchg>;

		__overlay__ {
			status = "okay";
			sprd,input-voltage-microvolt = <0x4c4b40>;
		};
	};

	fragment@6 {
		target = <&pmic_pd>;

		__overlay__ {
			status = "okay";
			sprd,syscon-aon-apb = <&aon_apb_regs>;

			usb_con: connector {
				compatible = "usb-c-connector";
				label = "USB-C";
				power-role = "dual";
				try-power-role = "sink";
				source-pdos = <0x4019028>;
				sink-pdos = <0x401912c>;
				op-sink-microwatt = <0x989680>;
			};
		};
	};

	fragment@7 {
		target = <&reserved_memory>;

		__overlay__ {
			protected_reserved: protected-mem@80003000 {
				reg = <0x0 0x80003000 0x0 0x2000>;
			};

			fd_reserved: faceid-mem@ffa70000 {
				reg = <0x0 0xffa70000 0x0 0x500000>;
			};
		};
	};

	fragment@8 {
		target = <&sipc>;

		__overlay__ {
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			sipc_wcn: core@3 {
				compatible = "sprd,sipc";
				reg = <0x3>;
				label = "sipc-wcn";
				mboxes = <&mailbox 0x8 0x0>;
				sprd,smem-info = <0x87240000 0x240000 0x140000>;

				wcn_bt {
					compatible = "sprd,wcn_internal_chip";
					sprd,name = "ttyBT";
					sprd,dst = <0x3>;
					sprd,channel = <0x4>;
					sprd,tx_bufid = <0xb>;
					sprd,rx_bufid = <0xa>;
				};

				wcn_fm {
					compatible = "sprd,wcn_fm_internal_chip";
					sprd,name = "fm";
					sprd,dst = <0x3>;
					sprd,tx_channel = <0x4>;
					sprd,rx_channel = <0x4>;
					sprd,tx_bufid = <0xe>;
					sprd,rx_bufid = <0xd>;
				};
			};

			sipc_gnss: core@4 {
				compatible = "sprd,sipc";
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				reg = <0x4>;
				label = "sipc-gnss";
				mboxes = <&mailbox 0x9 0x0>;
				sprd,smem-info = <0x8749b000 0x11b000 0x32000>;

				sttygnss0: channel@4 {
					compatible = "sprd,spipe";
					reg = <0x4>;
					label = "sttygnss0";
					sprd,ringnr = <0x1>;
					sprd,size-rxbuf = <0x19000>;
					sprd,size-txbuf = <0xc800>;
				};
			};
		};
	};

	fragment@9 {
		target = <&chosen>;

		__overlay__ {
			bootargs_ext = "kvm-arm.mode=none";
		};
	};

	fragment@10 {
		target = <&i2c0>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			sensor_main: sensor-main@20 {
				compatible = "sprd,sensor-main";
				reg = <0x20>;
				clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_76m8", "clk_48m", "clk_26m";
				clocks = <&mm_clk 0x2 &mm_gate 0xd &pll1 0x4 &pll1 0x10 &pll1 0x5 &ext_26m>;
				vddio-supply = <&vddcamio>;
				vddcama-supply = <&vddcama0>;
				vddcamd-supply = <&vddcamd0>;
				vddcammot-supply = <&vddcammot>;
				reset-gpios = <&ap_gpio 0x2c 0x0>;
				power-down-gpios = <&ap_gpio 0x2e 0x0>;
				sprd,phyid = <0x2>;
				csi = <&csi0>;
				power-domains = <&mm_domain>;
			};
		};
	};

	fragment@11 {
		target = <&i2c1>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			sensor_sub: sensor-sub@5a {
				compatible = "sprd,sensor-sub";
				reg = <0x5a>;
				clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_76m8", "clk_48m", "clk_26m";
				clocks = <&mm_clk 0x3 &mm_gate 0xc &pll1 0x4 &pll1 0x10 &pll1 0x5 &ext_26m>;
				vddio-supply = <&vddcamio>;
				vddcama-supply = <&vddcama1>;
				vddcamd-supply = <&vddcamd1>;
				reset-gpios = <&ap_gpio 0x29 0x0>;
				power-down-gpios = <&ap_gpio 0x28 0x0>;
				sprd,phyid = <0x0>;
				csi = <&csi1>;
				power-domains = <&mm_domain>;
			};

			sensor_main2: sensor-main2@20 {
				compatible = "sprd,sensor-main2";
				reg = <0x20>;
				clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_76m8", "clk_48m", "clk_26m";
				clocks = <&mm_clk 0x4 &mm_gate 0xb &pll1 0x4 &pll1 0x10 &pll1 0x5 &ext_26m>;
				vddcama-supply = <&vddcama1>;
				fakeserial-gpios = <&ap_gpio 0x7e 0x0>;
				sprd,phyid = <0x3>;
				csi = <&csi2>;
				power-domains = <&mm_domain>;
			};
		};
	};

	fragment@12 {
		target = <&i2c5>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;

			flash_ic: flash-ic@63 {
				compatible = "sprd,flash-ocp81375";
				flash-ic = <0x13ddf>;
				reg = <0x63>;
				flash-idx = <0x4>;
			};
		};
	};

	fragment@13 {
		target = <&i2c6>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			sensor_sub2: sensor-sub2@6e {
				compatible = "sprd,sensor-sub2";
				reg = <0x6e>;
				clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_76m8", "clk_48m", "clk_26m";
				clocks = <&mm_clk 0x4 &mm_gate 0xb &pll1 0x4 &pll1 0x10 &pll1 0x5 &ext_26m>;
				vddio-supply = <&vddcamio>;
				avdd-gpios = <&ap_gpio 0x82 0x0>;
				vddcamd-supply = <&vddcamd1>;
				vddcammot-supply = <&vddcammot>;
				mot-gpios = <&ap_gpio 0x70 0x0>;
				reset-gpios = <&ap_gpio 0x72 0x0>;
				sprd,phyid = <0x3>;
				csi = <&csi2>;
			};
		};
	};

	fragment@14 {
		target = <&hsphy>;

		__overlay__ {
			vdd-supply = <&vddusb33>;
			extcon = <&extcon_gpio>;
			sprd,hsphy-device-eye-pattern = <0x613d1c0>;
			sprd,hsphy-host-eye-pattern = <0x4f3d1c0>;
			status = "okay";
		};
	};

	fragment@15 {
		target = <&usb>;

		__overlay__ {
			extcon = <&extcon_gpio &pmic_typec>;
			vbus-supply = <&vddvbus>;
			status = "okay";
		};
	};

	fragment@16 {
		target = <&sdio0>;

		__overlay__ {
			cd-gpios = <&eic_sync 0x23 0x0>;
		};
	};

	fragment@17 {
		target = <&i2c2>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			sec-nfc@27 {
				compatible = "sec-nfc";
				reg = <0x27>;
				clock-names = "nfc_clk", "source", "enable";
				clocks = <&aon_clk 0x4 &ext_26m &aonapb_gate 0x6>;
				sec-nfc,ven-gpio = <&ap_gpio 0x3f 0x0>;
				sec-nfc,firm-gpio = <&ap_gpio 0x3d 0x0>;
				sec-nfc,irq-gpio = <&ap_gpio 0x3e 0x0>;
				sec-nfc,clk-req = <&ap_gpio 0x3c 0x0>;
			};
		};
	};

	fragment@18 {
		target = <&i2c3>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x1>;
			#size-cells = <0x0>;
		};
	};

	fragment@19 {
		target = <&i2c4>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			stm_vl53l0: vl53l0@52 {
				compatible = "st,stmvl53l0";
				reg = <0x52>;
				reset_gpios = <0xa8>;
				irq_gpios = <0xa9>;
				interrupt-parent = <&ap_gpio>;
				interrupts = <0xa9 0x8>;
			};
		};
	};

	fragment@20 {
		target = <&aon_i2c0>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0xf4240>;
		};
	};

	fragment@21 {
		target = <&sprd_headset>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@22 {
		target = <&pdm_dmic>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@23 {
		target = <&agdsp_domain>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@24 {
		target = <&sound_vbc_v4_sprd_codec>;

		__overlay__ {
			status = "okay";
			sprd,spk-ext-pa-info = <0x0 0x0 0x2 0x0>;
			sprd,spk-ext-pa-gpio = <&ap_gpio 0x71 0x0>;
		};
	};

	fragment@25 {
		target = <&vddldo0>;

		__overlay__ {
			regulator-always-on;
		};
	};

	fragment@26 {
		target = <&panel>;

		__overlay__ {
			avdd-gpio = <&ap_gpio 0x36 0x0>;
			avee-gpio = <&ap_gpio 0x37 0x0>;
			reset-gpio = <&ap_gpio 0x32 0x0>;
		};
	};

	fragment@27 {
		target = <&dpu>;

		__overlay__ {
			sprd,logo-memory = <&logo_reserved>;
		};
	};

	fragment@28 {
		target = <&ddr_dfs>;

		__overlay__ {
			sprd-scene = "boost", "lcdon", "lcdoff", "camlow", "camhigh", "camveryhigh", "faceid", "top", "boot-opt";
			sprd-freq = <0x535 0x300 0x100 0x535 0x535 0xbacd 0x535 0xbacd 0xbacd>;
		};
	};

	fragment@29 {
		target = <&pin_controller>;

		__overlay__ {
			pinctrl-names = "gpio_8", "gpio_22", "gpio_24", "gpio_25", "gpio_26", "gpio_124", "gpio_175";
			pinctrl-0 = <&gpio_8>;
			pinctrl-1 = <&gpio_22>;
			pinctrl-2 = <&gpio_24>;
			pinctrl-3 = <&gpio_25>;
			pinctrl-4 = <&gpio_26>;
			pinctrl-5 = <&gpio_124>;
			pinctrl-6 = <&gpio_175>;

			gpio_8: rfctl16 {
				pins = "QOGIRL6_RFCTL16";
				function = "func4";
			};

			gpio_22: rfctl3 {
				pins = "QOGIRL6_RFCTL3";
				function = "func4";
			};

			gpio_24: rfctl5 {
				pins = "QOGIRL6_RFCTL5";
				function = "func4";
			};

			gpio_25: rfctl6 {
				pins = "QOGIRL6_RFCTL6";
				function = "func4";
			};

			gpio_26: rfctl7 {
				pins = "QOGIRL6_RFCTL7";
				function = "func4";
			};

			gpio_124: keyin0 {
				pins = "QOGIRL6_KEYIN0";
				function = "func4";
			};

			gpio_175: bt_rfctl2 {
				pins = "QOGIRL6_BT_RFCTL2";
				function = "func4";
			};
		};
	};

	fragment@30 {
		target = <&dmabuf>;

		__overlay__ {
			fd-reserved {
				label = "carveout_fd";
				memory-region = <&fd_reserved>;
			};

			protected-reserved {
				label = "protected";
				memory-region = <&protected_reserved>;
			};
		};
	};

	fragment@31 {
		target = <&adi_bus>;

		__overlay__ {
			sprd,hw-channels = <0x2 0x18cc 0x3 0x18cc 0xd 0x1854 0xf 0x1874 0x11 0x1844 0x13 0x1844 0x15 0x1864 0x1e 0x1820 0x20 0x197c 0x21 0x1988 0x23 0x19b8 0x27 0x19ac>;
			sprd,hw-channels0 = <0x2 0x18cc 0x3 0x18cc 0xd 0x1874 0xf 0x1874 0x11 0x1844 0x13 0x1854 0x15 0x1864 0x1e 0x1820 0x20 0x197c 0x21 0x1988 0x23 0x19b8 0x27 0x19ac>;
			sprd,hw-channels1 = <0x2 0x18cc 0x3 0x18cc 0xd 0x1854 0xf 0x1874 0x11 0x1844 0x13 0x1844 0x15 0x1864 0x1e 0x1820 0x20 0x197c 0x21 0x1988 0x23 0x19b8 0x27 0x19ac>;
		};
	};

	fragment@32 {
		target = <&thm_zone>;

		__overlay__ {
			pa_thmzone: pa-thmzone {
				status = "disabled";
			};
		};
	};

	fragment@33 {
		target = <&thm_zone>;

		__overlay__ {
			chg_thmzone: chg-thmzone {
				status = "disabled";
			};
		};
	};
};
